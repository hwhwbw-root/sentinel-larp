# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgres://user:password@ep-example.neon.tech/sentinel?sslmode=require"

# Auth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Demo controls on the dashboard (Admin+). Keep "false" in production:
# it lets users inject fake readings into dedicated demo-co2 / demo-h2 devices.
DEMO_MODE="false"

# Vercel Blob (firmware .bin storage for the Firmware Update page)
# https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=""
