# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# mocksense local secrets
mocksense/device_keys.py

# typescript
*.tsbuildinfo
next-env.d.ts

# video creation: rendered media, caches, and large generated assets
/brag-output/
/videos/*/renders/
/videos/*/.thumbnails/
/videos/*/.hyperframes/frame-packets/
/video/out/
/video/node_modules/
/video/public/audio/soundscape.wav
/video/public/audio/senti_audio.mp3
*.mp4
*.mov
*.webm
*.remotion-in-progress
*.zip

# large duplicated or bundled assets
/canva-bunting-assets/
/public/branding/bunting/07_rollup_banner/*.svg
/pitch-deck/*.pptx

# installed agent skills (bundle large music/media assets)
/.agents/
/.claude/skills/
/skills-lock.json
